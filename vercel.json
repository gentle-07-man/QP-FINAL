{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/telegram",
      "destination": "/api/telegram.js"
    },
    {
      "source": "/.netlify/functions/sendToTelegram",
      "destination": "/api/telegram.js"
    },
    {
      "source": "/.netlify/functions/sendMock",
      "destination": "/api/telegram.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
